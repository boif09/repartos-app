# /etc/nginx/sites-available/repartos  (enlazar en sites-enabled)
# Pasos previos en el servidor:
#   1. DNS: registro A  repartos.jusboif.es -> 178.105.156.23
#   2. Certificado: certbot certonly --nginx -d repartos.jusboif.es
#   3. Authelia (/opt/authelia/config/configuration.yml), dentro de access_control.rules:
#        - domain: "repartos.jusboif.es"
#          policy: "one_factor"
#          subject: ["user:xavi", "user:judit"]
#      y reiniciar: docker restart authelia

server {
    listen 80;
    server_name repartos.jusboif.es;
    return 301 https://$host$request_uri;
}

server {
    listen 443 ssl;
    server_name repartos.jusboif.es;

    ssl_certificate /etc/letsencrypt/live/repartos.jusboif.es/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/repartos.jusboif.es/privkey.pem;
    include /etc/letsencrypt/options-ssl-nginx.conf;
    ssl_dhparam /etc/letsencrypt/ssl-dhparams.pem;

    client_max_body_size 1m;

    include /etc/nginx/snippets/authelia-location.conf;

    location / {
        include /etc/nginx/snippets/authelia-authrequest.conf;

        proxy_pass http://127.0.0.1:3014;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_set_header X-Forwarded-Host $host;
    }

    # F4: enlaces de solo lectura para amigos, sin Authelia.
    # Se borra Remote-User para que nadie pueda hacerse pasar por un usuario en estas rutas.
    # location ~ ^/(s/|api/shared/) {
    #     proxy_pass http://127.0.0.1:3014;
    #     proxy_http_version 1.1;
    #     proxy_set_header Host $host;
    #     proxy_set_header Remote-User "";
    #     proxy_set_header X-Real-IP $remote_addr;
    #     proxy_set_header X-Forwarded-Proto $scheme;
    # }
}
