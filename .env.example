# Copia este archivo a .env para desarrollo local (.env no se sube a git).
# En producción el login lo hace Authelia y estas variables vienen de ecosystem.config.cjs.

# Simula el usuario que Authelia enviaría en la cabecera Remote-User. Prohibido en producción.
DEV_REMOTE_USER=xavi

# Usuarios de Authelia que pueden entrar (separados por comas).
APP_USERS=xavi,judit

PORT=3014
HOST=127.0.0.1
BASE_PATH=/
# DB_PATH=data/repartos.db
